#!/usr/bin/env bash

# Runs at login: rebuilds Glassy Black & Pink from the clone it was installed
# from when KDE's libraries changed, then reloads its glass.
set -euo pipefail

source_dir="$(</usr/share/glassy-blacknpink/source)"
[ -f "$source_dir/install.sh" ] || {
    printf 'Glassy Black & Pink source is missing at %s; run install.sh from your clone again\n' "$source_dir" >&2
    exit 1
}
exec /usr/bin/bash "$source_dir/install.sh"
